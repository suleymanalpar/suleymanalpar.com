# Netlify güvenlik başlıkları — tüm yollar için
# Ref: https://docs.netlify.com/routing/headers/
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  # CSP: mevcut inline stiller (style="...") ve inline event handler'lar (onclick vb.)
  # nedeniyle 'unsafe-inline' gerekiyor. Inline'lar harici JS/CSS'e taşındıkça
  # script-src ve style-src 'self''e sıkılaştırılabilir (bkz. yol haritası Faz 3).
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: https://*.goatcounter.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; font-src 'self'; connect-src 'self' https://*.goatcounter.com; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Statik varlıklar için uzun önbellek (içerik-hash'siz olduğundan makul süre)
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800
/img/*
  Cache-Control: public, max-age=2592000

# Service worker taze kalmalı
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
